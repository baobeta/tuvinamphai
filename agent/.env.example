# Credential: ANTHROPIC_API_KEY, hoặc đăng nhập bằng `ant auth login` (SDK tự đọc profile).
ANTHROPIC_API_KEY=
# Thư mục chứa 4 cuốn sách + kho tri thức. Mặc định: gốc repo (thư mục cha của agent/)
# TUVI_WORKSPACE=..
# Ghi đè riêng thư mục kho tri thức nếu cần
# TUVI_KB_DIR=../Kien-thuc-Tu-Vi-Nam-Phai
TUVI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TUVI_EFFORT=high
TUVI_MAX_ITERATIONS=20
# TUVI_CHART_DIR=../.omc/charts   (mặc định; ghi "off" để không lưu lá số ra file)
# Nếu đặt TUVI_CHART_DIR hoặc TUVI_WORKSPACE ra ngoài repo, nhớ đưa thư mục đó vào .gitignore: file lá số chứa ngày giờ sinh.
